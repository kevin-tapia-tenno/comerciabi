# ============================================================
# ComercioBI - API FastAPI
#
# Copiar como:
#   api/.env
#
# Nunca subir api/.env a Git.
# ============================================================


# ------------------------------------------------------------
# Aplicación
# ------------------------------------------------------------

APP_ENV=development
LOG_LEVEL=INFO

# URL pública de la aplicación. Se usa para el enlace de invitación.
APP_PUBLIC_URL=http://localhost:5173


# ------------------------------------------------------------
# Supabase Auth
#
# SUPABASE_PUBLISHABLE_KEY utiliza la nueva generación de
# claves sb_publishable_... de Supabase.
# ------------------------------------------------------------

SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_PUBLISHABLE_KEY=

# Clave secreta de Supabase (sb_secret_... o service_role legado).
# SOLO servidor. Nunca copiar al frontend ni a VITE_*.
SUPABASE_SECRET_KEY=


# ------------------------------------------------------------
# PostgreSQL
#
# Para Vercel / serverless usamos Supavisor Transaction Pooler.
# Puerto: 6543
#
# La API debe conectarse mediante el rol restringido
# comerciabi_api y NO mediante postgres.
# ------------------------------------------------------------

API_DB_HOST=aws-0-<REGION>.pooler.supabase.com
API_DB_PORT=6543
API_DB_NAME=postgres

API_DB_USER=comerciabi_api.<PROJECT_REF>
API_DB_PASSWORD=

API_DB_SSLMODE=require


# ------------------------------------------------------------
# CORS
#
# En producción agregar el dominio real de ComercioBI.
# ------------------------------------------------------------

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
