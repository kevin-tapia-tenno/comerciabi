# ComercioBI - conexión PostgreSQL para ETL
#
# En Supabase abre el botón Connect y usa los datos de Session pooler.
# NO escribas aquí la contraseña real si este archivo será subido a Git.
# Copia este archivo como .env y completa SOLO el .env local.

DB_HOST=TU_HOST_DEL_SESSION_POOLER
DB_PORT=5432
DB_NAME=postgres
DB_USER=TU_USUARIO_DEL_SESSION_POOLER
DB_PASSWORD=TU_PASSWORD_DE_BASE_DE_DATOS
DB_SSLMODE=require
